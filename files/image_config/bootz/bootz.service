[Unit]
Description=BootZ Bootstrap Service
After=network-online.target rc-local.service config-setup.service
Before=gnmi.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bootz boot
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=sonic.target
