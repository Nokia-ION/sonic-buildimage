#!/bin/bash
#
# Factory default hook: deep merge the vendor config that bootz-client staged
# for this image into the generated factory default config. The vendor config
# wins where both set a value, and a null value removes the key from the
# factory default config (JSON Merge Patch, RFC 7386), for example
# "VLAN_MEMBER": {"Vlan1000|Ethernet0": null} to make Ethernet0 a routed port.
#
# If the vendor config cannot be merged, or the merged config fails the YANG
# validation of config reload, the config_db.json that bootz-client backed up
# before provisioning is restored instead, and the vendor config is renamed
# to vendor_config.json.rejected for the bootz boot report.
#
# config-setup sources this hook from generate_config, with the generated
# config in DEST_FILE, so it must not exit.

# Usage: bootz_validate_config <config_db.json>
# config reload aborts on a config that fails this validation.
bootz_validate_config()
{
    python3 - "$1" << 'EOF'
import sys
from config.main import config_file_yang_validation
try:
    valid = config_file_yang_validation(sys.argv[1])
except BaseException:
    valid = False
sys.exit(0 if valid else 1)
EOF
}

# Usage: bootz_merge_patch <config_db.json> <vendor_config.json>
bootz_merge_patch()
{
    jq --indent 4 -s '
        def merge_patch($patch):
            if ($patch | type) == "object" then
                reduce ($patch | to_entries[]) as $e
                    (if type == "object" then . else {} end;
                     if $e.value == null then del(.[$e.key])
                     else .[$e.key] |= merge_patch($e.value) end)
            else $patch end;
        .[1] as $patch | .[0] | merge_patch($patch)' "$1" "$2"
}

bootz_merge_vendor_config()
{
    local version bootz_dir vendor_config previous_config dest tmp reason=""

    version=$(sonic-cfggen -y /etc/sonic/sonic_version.yml -v build_version)
    bootz_dir="/host/image-${version}/bootz"
    vendor_config="${bootz_dir}/vendor_config.json"
    previous_config="${bootz_dir}/config_db.json.pre-bootz"
    dest="${DEST_FILE:-/etc/sonic/config_db.json}"
    tmp="${dest}.bootz.$$"

    [ -f "$vendor_config" ] || return 0

    # Except for keep-basic, config-setup runs these hooks before it generates
    # the factory default config, and only generates it if no hook did.
    if ! jq -e 'type == "object"' "$vendor_config" > /dev/null 2>&1; then
        reason="it is not a config_db.json object"
    elif [ ! -e "$dest" ] && ! sonic-cfggen -H -k ${HW_KEY} --preset ${DEFAULT_PRESET} > "$dest"; then
        rm -f "$dest"
        reason="generating the factory default config failed"
    elif ! bootz_merge_patch "$dest" "$vendor_config" > "$tmp"; then
        reason="merging it into the factory default config failed"
    elif ! bootz_validate_config "$tmp"; then
        reason="the merged config fails YANG validation"
    fi

    if [ -n "$reason" ]; then
        rm -f "$tmp"
        # Rejected once: a later factory reset must not retry it.
        mv -f "$vendor_config" "${vendor_config}.rejected"
        echo "Bootz vendor config $vendor_config not applied: $reason"
        if [ -f "$previous_config" ] && cp -f "$previous_config" "$dest"; then
            echo "Restored the config from before bootz provisioning $previous_config to $dest"
        else
            echo "No config from before bootz provisioning restored, using the factory default config"
        fi
        # config-setup only prefers minigraph.xml before it runs these hooks.
        if [ -f "${bootz_dir}/minigraph.xml.pre-bootz" ] &&
           cp -f "${bootz_dir}/minigraph.xml.pre-bootz" /etc/sonic/minigraph.xml; then
            echo "Restored the minigraph from before bootz provisioning to /etc/sonic/minigraph.xml," \
                 "run 'config load_minigraph' to load it"
        fi
        return 1
    fi

    mv -f "$tmp" "$dest"
    # Merged once: a later factory reset must not bring it back.
    mv -f "$vendor_config" "${vendor_config}.merged"
    echo "Merged bootz vendor config $vendor_config into $dest"
}

bootz_merge_vendor_config
