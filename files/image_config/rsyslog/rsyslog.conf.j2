###############################################################################
# Managed by Ansible
# file: ansible/roles/acs/templates/rsyslog.conf.j2
###############################################################################
#
#  /etc/rsyslog.conf    Configuration file for rsyslog.
#
#                       For more information see
#                       /usr/share/doc/rsyslog-doc/html/rsyslog_conf.html


#################
#### MODULES ####
#################

{% set gconf = (SYSLOG_CONFIG | d({})).get('GLOBAL', {}) -%}
{% set rate_limit_interval = gconf.get('rate_limit_interval') -%}
{% set rate_limit_burst = gconf.get('rate_limit_burst') -%}
{% set tls_profiles = ssl_profiles | d({}) -%}

global(net.enableDNS="off")

module(load="imuxsock" {% if rate_limit_interval is not none %}SysSock.RateLimit.Interval="{{ rate_limit_interval }}"{% endif %} {% if rate_limit_burst is not none %}SysSock.RateLimit.Burst="{{ rate_limit_burst }}"{% endif %}) # provides support for local system logging
module(load="imklog" ParseKernelTimestamp="off" KeepKernelTimestamp="on")   # provides kernel logging support
#module(load="immark")  # provides --MARK-- message capability
{% if syslog_counter and syslog_counter == "true" %}
module(load="omprog")
{% endif %}

# provides UDP syslog reception
module(load="imudp")
input(type="imudp" address="{{udp_server_ip}}" port="514")
{% if docker0_ip and docker0_ip != "" and docker0_ip != udp_server_ip %}
input(type="imudp" address="{{docker0_ip}}" port="514")
{% endif%}

# provides TCP syslog reception
#module(load="imtcp")
#input(type="imtcp" port="514")

# provides RELP syslog reception
module(load="imrelp")
input(type="imrelp" address="{{udp_server_ip}}" port="2514")
{% if docker0_ip and docker0_ip != "" and docker0_ip != udp_server_ip %}
input(type="imrelp" address="{{docker0_ip}}" port="2514")
{% endif%}


###########################
#### GLOBAL DIRECTIVES ####
###########################
{% set hostname = ((DEVICE_METADATA | default({})).get('localhost', {})).get('hostname') | default('sonic', true) | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') -%}
{% set os_version = os_version | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') -%}
{% set format = gconf.get('format', 'standard') -%}
{% set fw_name = gconf.get('welf_firewall_name', hostname) -%}
#
# Use traditional timestamp format.
# To enable high precision timestamps, comment out the following line.
#
#$ActionFileDefaultTemplate RSYSLOG_TraditionalFileFormat

# Define a custom template
$template SONiCFileFormat,"%TIMESTAMP:::date-year% %TIMESTAMP%.%TIMESTAMP:::date-subseconds% {{ hostname }} %syslogseverity-text:::uppercase% %syslogtag%%msg:::sp-if-no-1st-sp%%msg:::drop-last-lf%\n"
$ActionFileDefaultTemplate SONiCFileFormat
$template SONiCForwardFormat,"<%PRI%>%TIMESTAMP:::date-rfc3339% {{ hostname }} %syslogseverity-text:::uppercase% %syslogtag%%msg:::sp-if-no-1st-sp%%msg:::drop-last-lf%\n"
$template SONiCForwardFormatWithOsVersion,"<%PRI%>%TIMESTAMP:::date-rfc3339% {{ hostname }}  {{os_version}} %syslogseverity-text:::uppercase% %syslogtag%%msg:::sp-if-no-1st-sp%%msg:::drop-last-lf%\n"

{% if forward_with_osversion and forward_with_osversion == "true" %}
$ActionForwardDefaultTemplate SONiCForwardFormatWithOsVersion
{% else%}
$ActionForwardDefaultTemplate SONiCForwardFormat
{% endif%}


template(name="WelfRemoteFormat" type="string" string="%TIMESTAMP% id=firewall time=\"%timereported\
:::date-year%-%timereported:::date-month%-%timereported:::date-day% %timereported:::date-hour%:%timereported:::date-minute%:%timereported\
:::date-second%\" fw=\"{{ fw_name | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') }}\" pri=%syslogpriority% msg=\"%syslogtag%%msg:::sp-if-no-1st-sp%%msg:::drop-last-lf%\"\n")

#
# Remote syslog logging
#

# The omfwd plug-in provides the core functionality of traditional message
# forwarding via UDP and plain TCP. It is a built-in module that does not need
# to be loaded.

{% set servers = SYSLOG_SERVER | d({}) -%}
{% for server in servers %}
{% set conf = servers[server] | d({}) -%}

{% set source = conf.get('source') -%}
{# Fall back to the global source interface IP (SYSLOG_CONFIG|GLOBAL:src_intf,
   resolved by rsyslog-config.sh) when this server has no explicit source. -#}
{% if not source -%}
    {% if ':' in (server | string) and syslog_src_ip6 is defined and syslog_src_ip6 %}{% set source = syslog_src_ip6 -%}
    {% elif syslog_src_ip is defined and syslog_src_ip %}{% set source = syslog_src_ip -%}
    {% endif -%}
{% endif -%}
{% if source %}{% set source = source | string | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') %}{% endif -%}
{% set proto = conf.get('protocol', 'udp') | string | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') -%}
{% set transport_security = conf.get('transport_security', 'false') | string | lower -%}
{% set use_tls = (proto == 'tls') or (transport_security in ['true', 'tls', 'enabled', '1']) -%}
{% set profile_id = conf.get('tls_profile_id') -%}
{% if profile_id %}{% set profile_id = profile_id | string | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') %}{% endif -%}
{% set tls_ready = use_tls and profile_id and tls_profiles.get(profile_id) -%}
{% if use_tls -%}
{% set proto = 'tcp' -%}
{% set port = conf.get('port', 6514) | int(6514) -%}
{% else -%}
{% set port = conf.get('port', 514) | int(514) -%}
{% endif -%}
{% set vrf = conf.get('vrf', 'default') | string | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') -%}
{% set severity = conf.get('severity', gconf.get('severity', '*')) | string | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') -%}
{% set facility = conf.get('facility', '*') | string | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') -%}
{% set filter = conf.get('filter') -%}
{% set regex = conf.get('filter_regex') -%}

{% set fmodifier = '!' if filter == 'exclude' else '' %}
{% set device = vrf if vrf != '' and vrf != 'default' -%}

{% if format == 'welf' %}
{% set template = 'WelfRemoteFormat'%}
{% elif forward_with_osversion and forward_with_osversion == "true"%}
{% set template = 'SONiCForwardFormatWithOsVersion'%}
{% else%}
{% set template = 'SONiCForwardFormat'%}
{% endif%}


{# Server extra options -#}
{% set options = '' -%}

{% if source -%}
    {% set options = options ~ ' Address="' ~ source ~ '"'-%}
    {% set device = device if device != 'eth0' else '' -%}
{% endif -%}

{% if device -%}
    {% set options = options ~ ' Device="' ~ device ~ '"'-%}
{% endif -%}

{% if use_tls and not tls_ready %}
# TLS requested for {{ server }} (profile {{ profile_id | d('unset') }}) but
# /etc/sonic/ssl-certs/{{ profile_id | d('') }}/{ca-bundle,cert,key}.pem are not
# all present. Skip this server; do not fall back to cleartext omfwd.
{% else %}
{% if filter %}
:msg, {{ fmodifier }}ereregex, "{{ regex | replace('\n', '') | replace('\r', '') | replace('"', '\\"') }}"
{% endif %}
{% if use_tls %}
{% set cert_dir = '/etc/sonic/ssl-certs/' ~ profile_id -%}
{{ facility }}.{{ severity }}
action(type="omfwd" Target="{{ server | string | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') }}" Port="{{ port }}" Protocol="tcp" Template="{{ template }}" action.resumeRetryCount="60" queue.type="LinkedList" queue.size="20000" StreamDriver="ossl" StreamDriverMode="1" StreamDriverAuthMode="x509/name" StreamDriver.CAFile="{{ cert_dir }}/ca-bundle.pem" StreamDriver.CertFile="{{ cert_dir }}/cert.pem" StreamDriver.KeyFile="{{ cert_dir }}/key.pem"{{ options }})
{% else %}
{{ facility }}.{{ severity }}
action(type="omfwd" Target="{{ server | string | replace('\n', '') | replace('\r', '') | replace('"', '') | replace('\\', '') | replace('%', '') }}" Port="{{ port }}" Protocol="{{ proto }}" Template="{{ template }}" action.resumeRetryCount="60" queue.type="LinkedList" queue.size="20000"{{ options }})
{% endif %}
{% endif %}
{% endfor %}

{% if syslog_counter and syslog_counter == "true" %}
# update rsyslog counter
action(type="omprog" binary="/usr/bin/syslog-counter" output="/var/log/syslog_counter.log" confirmMessages="on" signalOnClose="on")
{% endif%}

#
# Set the default permissions for all log files.
#
$FileOwner root
$FileGroup adm
$FileCreateMode 0640
$DirCreateMode 0755
$Umask 0022

#
# Where to place spool and state files
#
$WorkDirectory /var/spool/rsyslog

#
# Include all config files in /etc/rsyslog.d/
#
$IncludeConfig /etc/rsyslog.d/*.conf

#
# Suppress duplicate messages and report "message repeated n times"
#
$RepeatedMsgReduction on

###############
#### RULES ####
###############
