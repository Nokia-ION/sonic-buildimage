# Nokia Platform

ASPEED_AST_PLATFORM_VERSION = 1.0
export ASPEED_AST_PLATFORM_VERSION
SONIC_KERNEL_DEB_PKG = $(LINUX_KERNEL)
export SONIC_KERNEL_DEB_PKG

ASPEED_AST2700_EVB_PLATFORM = sonic-platform-aspeed-ast2700-evb_$(ASPEED_AST_PLATFORM_VERSION)_$(CONFIGURED_ARCH).deb
$(ASPEED_AST2700_EVB_PLATFORM)_PLATFORM = $(CONFIGURED_ARCH)-ast2700_evb-r0
$(ASPEED_AST2700_EVB_PLATFORM)_SRC_PATH = $(PLATFORM_PATH)/sonic-platform-aspeed
$(ASPEED_AST2700_EVB_PLATFORM)_DEPENDS += $(LINUX_HEADERS) $(LINUX_HEADERS_COMMON)

SONIC_DPKG_DEBS += $(ASPEED_AST2700_EVB_PLATFORM)
