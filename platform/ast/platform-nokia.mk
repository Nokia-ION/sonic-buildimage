# Nokia Platform

NOKIA_AST_PLATFORM_VERSION = 1.0
export NOKIA_AST_PLATFORM_VERSION
SONIC_KERNEL_DEB_PKG = $(LINUX_KERNEL)
export SONIC_KERNEL_DEB_PKG

NOKIA_AST2700_PLATFORM = sonic-platform-nokia_ast2700_$(NOKIA_AST_PLATFORM_VERSION)_$(CONFIGURED_ARCH).deb
$(NOKIA_AST2700_PLATFORM)_PLATFORM = $(CONFIGURED_ARCH)-nokia_ast2700-r0
$(NOKIA_AST2700_PLATFORM)_SRC_PATH = $(PLATFORM_PATH)/sonic-platform-nokia
$(NOKIA_AST2700_PLATFORM)_DEPENDS += $(LINUX_HEADERS) $(LINUX_HEADERS_COMMON)

SONIC_DPKG_DEBS += $(NOKIA_AST2700_PLATFORM)
