+    // Built-in L3 tables advertise SET_TC on ingress when the platform supports it.
+    TEST_F(AclOrchTest, L3Acl_Set_Tc_Action)
+    {
+        const string aclTableName = "L3_SET_TC_TABLE";
+        const string aclRuleName  = "L3_SET_TC_RULE";
+
+        auto orch = createAclOrch();
+
+        if (!orch->isAclActionSupported(ACL_STAGE_INGRESS, SAI_ACL_ACTION_TYPE_SET_TC))
+        {
+            GTEST_SKIP() << "SAI_ACL_ACTION_TYPE_SET_TC not supported by test SAI";
+        }
+
+        orch->doAclTableTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableName, SET_COMMAND,
+                    { { ACL_TABLE_DESCRIPTION, "L3 set-tc table" },
+                      { ACL_TABLE_TYPE, TABLE_TYPE_L3 },
+                      { ACL_TABLE_STAGE, STAGE_INGRESS },
+                      { ACL_TABLE_PORTS, "1,2" } } } }));
+        ASSERT_TRUE(orch->getAclTable(aclTableName));
+
+        orch->doAclRuleTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableName + "|" + aclRuleName, SET_COMMAND,
+                    { { MATCH_SRC_IP, "10.0.0.1/32" },
+                      { MATCH_IP_PROTOCOL, "6" },
+                      { MATCH_L4_DST_PORT, "443" },
+                      { ACTION_PACKET_ACTION, PACKET_ACTION_FORWARD },
+                      { ACTION_SET_TC, "4" } } } }));
+
+        auto rule = orch->getAclRule(aclTableName, aclRuleName);
+        ASSERT_TRUE(rule);
+        const auto &actions = Portal::AclRuleInternal::getActions(rule);
+        auto setTcIt = actions.find(SAI_ACL_ENTRY_ATTR_ACTION_SET_TC);
+        ASSERT_NE(setTcIt, actions.end());
+        EXPECT_EQ(setTcIt->second.getSaiAttr().value.aclaction.parameter.u8, 4);
+        ASSERT_NE(actions.find(SAI_ACL_ENTRY_ATTR_ACTION_PACKET_ACTION), actions.end());
+    }
+
+    // SET_TC assigns a traffic class on matching packets when the platform
+    // advertises SAI_ACL_ACTION_TYPE_SET_TC and the table type includes SET_TC.
+    TEST_F(AclOrchTest, AclRule_Set_Tc_Action)
+    {
+        const string aclTableTypeName = "TEST_SET_TC_TYPE";
+        const string aclTableName     = "TEST_SET_TC_TABLE";
+        const string aclRuleName      = "TEST_SET_TC_RULE";
+
+        auto orch = createAclOrch();
+
+        if (!orch->isAclActionSupported(ACL_STAGE_INGRESS, SAI_ACL_ACTION_TYPE_SET_TC))
+        {
+            GTEST_SKIP() << "SAI_ACL_ACTION_TYPE_SET_TC not supported by test SAI";
+        }
+
+        orch->doAclTableTypeTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableTypeName, SET_COMMAND,
+                    { { ACL_TABLE_TYPE_MATCHES, MATCH_SRC_IP },
+                      { ACL_TABLE_TYPE_ACTIONS,
+                        string(ACTION_PACKET_ACTION) + "," + ACTION_SET_TC },
+                      { ACL_TABLE_TYPE_BPOINT_TYPES, BIND_POINT_TYPE_PORT } } } }));
+
+        orch->doAclTableTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableName, SET_COMMAND,
+                    { { ACL_TABLE_DESCRIPTION, "set-tc table" },
+                      { ACL_TABLE_TYPE, aclTableTypeName },
+                      { ACL_TABLE_STAGE, STAGE_INGRESS },
+                      { ACL_TABLE_PORTS, "1,2" } } } }));
+        ASSERT_TRUE(orch->getAclTable(aclTableName));
+
+        orch->doAclRuleTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableName + "|" + aclRuleName, SET_COMMAND,
+                    { { MATCH_SRC_IP, "1.1.1.1/32" },
+                      { ACTION_PACKET_ACTION, PACKET_ACTION_FORWARD },
+                      { ACTION_SET_TC, "5" } } } }));
+
+        auto rule = orch->getAclRule(aclTableName, aclRuleName);
+        ASSERT_TRUE(rule);
+        const auto &actions = Portal::AclRuleInternal::getActions(rule);
+        auto setTcIt = actions.find(SAI_ACL_ENTRY_ATTR_ACTION_SET_TC);
+        ASSERT_NE(setTcIt, actions.end());
+        EXPECT_EQ(setTcIt->second.getSaiAttr().value.aclaction.parameter.u8, 5);
+
+        orch->doAclRuleTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableName + "|" + aclRuleName, DEL_COMMAND, {} } }));
+        ASSERT_FALSE(orch->getAclRule(aclTableName, aclRuleName));
+
+        orch->doAclRuleTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableName + "|" + "INVALID_TC_RULE", SET_COMMAND,
+                    { { MATCH_SRC_IP, "2.2.2.2/32" },
+                      { ACTION_PACKET_ACTION, PACKET_ACTION_FORWARD },
+                      { ACTION_SET_TC, "8" } } } }));
+        ASSERT_FALSE(orch->getAclRule(aclTableName, "INVALID_TC_RULE"));
+    }
+
+    // SET_TC on a table type that does not advertise the action is rejected.
