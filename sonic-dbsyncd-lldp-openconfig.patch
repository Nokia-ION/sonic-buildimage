+# lldpd JSON uses short labels ("Wlan", "Station", "Tel") that do not match
+# the IEEE/SNMP enumerant names. Map both onto the same bit index.
+LLDP_CAPABILITY_NAME_TO_BIT = {
+    "other": 0,
+    "repeater": 1,
+    "bridge": 2,
+    "mac_bridge": 2,
+    "mac-bridge": 2,
+    "wlanaccesspoint": 3,
+    "wlan": 3,
+    "wlan_access_point": 3,
+    "router": 4,
