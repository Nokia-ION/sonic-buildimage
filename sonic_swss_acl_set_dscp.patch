diff --git a/tests/mock_tests/aclorch_ut.cpp b/tests/mock_tests/aclorch_ut.cpp
index 394ad7a7..cf77cf43 100755
--- a/tests/mock_tests/aclorch_ut.cpp
+++ b/tests/mock_tests/aclorch_ut.cpp
@@ -1641,6 +1641,64 @@ namespace aclorch_test
         ASSERT_FALSE(orch->getAclRule(aclTableName, aclRuleName));
     }
 
+    // SET_DSCP rewrites the DSCP of matching packets next to SET_TC on a table
+    // type that lists it; a value outside 0-63 is rejected.
+    TEST_F(AclOrchTest, AclRule_Set_Dscp_Action)
+    {
+        const string aclTableTypeName = "TEST_SET_DSCP_TYPE";
+        const string aclTableName     = "TEST_SET_DSCP_TABLE";
+        const string aclRuleName      = "TEST_SET_DSCP_RULE";
+
+        auto orch = createAclOrch();
+
+        if (!orch->isAclActionSupported(ACL_STAGE_INGRESS, SAI_ACL_ACTION_TYPE_SET_DSCP) ||
+            !orch->isAclActionSupported(ACL_STAGE_INGRESS, SAI_ACL_ACTION_TYPE_SET_TC))
+        {
+            GTEST_SKIP() << "SAI_ACL_ACTION_TYPE_SET_DSCP or SET_TC not supported by test SAI";
+        }
+
+        orch->doAclTableTypeTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableTypeName, SET_COMMAND,
+                    { { ACL_TABLE_TYPE_MATCHES, string(MATCH_SRC_IP) + "," + MATCH_DSCP },
+                      { ACL_TABLE_TYPE_ACTIONS,
+                        string(ACTION_PACKET_ACTION) + "," + ACTION_SET_TC + "," + ACTION_SET_DSCP },
+                      { ACL_TABLE_TYPE_BPOINT_TYPES, BIND_POINT_TYPE_PORT } } } }));
+
+        orch->doAclTableTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableName, SET_COMMAND,
+                    { { ACL_TABLE_DESCRIPTION, "set-dscp table" },
+                      { ACL_TABLE_TYPE, aclTableTypeName },
+                      { ACL_TABLE_STAGE, STAGE_INGRESS },
+                      { ACL_TABLE_PORTS, "1,2" } } } }));
+        ASSERT_TRUE(orch->getAclTable(aclTableName));
+
+        orch->doAclRuleTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableName + "|" + aclRuleName, SET_COMMAND,
+                    { { MATCH_DSCP, "5" },
+                      { ACTION_PACKET_ACTION, PACKET_ACTION_FORWARD },
+                      { ACTION_SET_TC, "4" },
+                      { ACTION_SET_DSCP, "4" } } } }));
+
+        auto rule = orch->getAclRule(aclTableName, aclRuleName);
+        ASSERT_TRUE(rule);
+        const auto &actions = Portal::AclRuleInternal::getActions(rule);
+        auto setDscpIt = actions.find(SAI_ACL_ENTRY_ATTR_ACTION_SET_DSCP);
+        ASSERT_NE(setDscpIt, actions.end());
+        EXPECT_EQ(setDscpIt->second.getSaiAttr().value.aclaction.parameter.u8, 4);
+        ASSERT_NE(actions.find(SAI_ACL_ENTRY_ATTR_ACTION_SET_TC), actions.end());
+
+        orch->doAclRuleTask(
+            deque<KeyOpFieldsValuesTuple>(
+                { { aclTableName + "|" + "INVALID_DSCP_RULE", SET_COMMAND,
+                    { { MATCH_SRC_IP, "2.2.2.2/32" },
+                      { ACTION_PACKET_ACTION, PACKET_ACTION_FORWARD },
+                      { ACTION_SET_DSCP, "64" } } } }));
+        ASSERT_FALSE(orch->getAclRule(aclTableName, "INVALID_DSCP_RULE"));
+    }
+
     // An ACL rule with POLICER_ACTION referencing a POLICER entry is realized as
     // SAI_ACL_ENTRY_ATTR_ACTION_SET_POLICER. A rule referencing a policer that
     // does not exist yet is deferred (relies on the m_toSync retry) and not created.
