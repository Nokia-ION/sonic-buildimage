From a26ad9cb5a621c30131af132a1836b9f8d3581bc Mon Sep 17 00:00:00 2001
From: varunama <varuna.m@nokia.com>
Date: Tue, 25 Aug 2026 18:32:50 +0530
Subject: [PATCH] Add runtime setters for LACP runner options

Allow teamdctl state item set for runner.min_ports, runner.fallback,
runner.fallback_timeout, runner.fast_rate and runner.active so SONiC can
change these parameters (including lacp-mode) without recreating the LAG.
Each setter updates lacp->cfg and re-evaluates carrier/selection, timers,
or advertises the new LACP actor state as needed.

Fallback enable/disable and timeout changes drive PORT_STATE_FALLBACK
election: only one defaulted member that has waited out fallback_timeout
is selected, and disabling fallback clears an existing fallback member.
---
 teamd/teamd_runner_lacp.c | 319 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 319 insertions(+)

diff --git a/teamd/teamd_runner_lacp.c b/teamd/teamd_runner_lacp.c
index 93bb82d..241a782 100644
--- a/teamd/teamd_runner_lacp.c
+++ b/teamd/teamd_runner_lacp.c
@@ -2283,6 +2283,62 @@ static int lacp_state_active_get(struct teamd_context *ctx,
 	return 0;
 }
 
+struct lacp_state_active_info {
+	struct teamd_workq workq;
+	struct lacp *lacp;
+	bool active;
+};
+
+static int lacp_state_active_work(struct teamd_context *ctx,
+				  struct teamd_workq *workq)
+{
+	struct lacp_state_active_info *info;
+	struct lacp *lacp;
+	struct teamd_port *tdport;
+	int err = 0;
+
+	info = get_container(workq, struct lacp_state_active_info, workq);
+	lacp = info->lacp;
+	if (info->active == lacp->cfg.active)
+		goto out;
+
+	teamd_log_dbg(ctx, "active manually changed from %d to %d",
+		      lacp->cfg.active, info->active);
+	lacp->cfg.active = info->active;
+
+	teamd_for_each_tdport(tdport, lacp->ctx) {
+		struct lacp_port *lacp_port = lacp_port_get(lacp, tdport);
+
+		lacp_port_actor_update(lacp_port);
+		lacp_port_periodic_cb_change_enabled(lacp_port);
+		if (lacp_port_selected(lacp_port)) {
+			err = lacpdu_send(lacp_port);
+			if (err)
+				goto out;
+		}
+	}
+out:
+	free(info);
+	return err;
+}
+
+static int lacp_state_active_set(struct teamd_context *ctx,
+				 struct team_state_gsc *gsc,
+				 void *priv)
+{
+	struct lacp_state_active_info *info;
+	struct lacp *lacp = priv;
+
+	info = malloc(sizeof(*info));
+	if (!info)
+		return -ENOMEM;
+	teamd_workq_init_work(&info->workq, lacp_state_active_work);
+	info->lacp = lacp;
+	info->active = gsc->data.bool_val;
+	teamd_workq_schedule_work(ctx, &info->workq);
+	return 0;
+}
+
 static int lacp_state_sys_prio_get(struct teamd_context *ctx,
 				   struct team_state_gsc *gsc,
 				   void *priv)
@@ -2303,6 +2359,64 @@ static int lacp_state_fast_rate_get(struct teamd_context *ctx,
 	return 0;
 }
 
+struct lacp_state_fast_rate_info {
+	struct teamd_workq workq;
+	struct lacp *lacp;
+	bool fast_rate;
+};
+
+static int lacp_state_fast_rate_work(struct teamd_context *ctx,
+				     struct teamd_workq *workq)
+{
+	struct lacp_state_fast_rate_info *info;
+	struct lacp *lacp;
+	struct teamd_port *tdport;
+	int err = 0;
+
+	info = get_container(workq, struct lacp_state_fast_rate_info, workq);
+	lacp = info->lacp;
+	if (info->fast_rate == lacp->cfg.fast_rate)
+		goto out;
+
+	teamd_log_dbg(ctx, "fast_rate manually changed from %d to %d",
+		      lacp->cfg.fast_rate, info->fast_rate);
+	lacp->cfg.fast_rate = info->fast_rate;
+
+	teamd_for_each_tdport(tdport, lacp->ctx) {
+		struct lacp_port *lacp_port = lacp_port_get(lacp, tdport);
+
+		lacp_port_actor_update(lacp_port);
+		err = lacp_port_timeout_set(lacp_port, false);
+		if (err)
+			goto out;
+		if (lacp_port_selected(lacp_port)) {
+			err = lacpdu_send(lacp_port);
+			if (err)
+				goto out;
+		}
+	}
+out:
+	free(info);
+	return err;
+}
+
+static int lacp_state_fast_rate_set(struct teamd_context *ctx,
+				    struct team_state_gsc *gsc,
+				    void *priv)
+{
+	struct lacp_state_fast_rate_info *info;
+	struct lacp *lacp = priv;
+
+	info = malloc(sizeof(*info));
+	if (!info)
+		return -ENOMEM;
+	teamd_workq_init_work(&info->workq, lacp_state_fast_rate_work);
+	info->lacp = lacp;
+	info->fast_rate = gsc->data.bool_val;
+	teamd_workq_schedule_work(ctx, &info->workq);
+	return 0;
+}
+
 static int lacp_state_fallback_get(struct teamd_context *ctx,
 				   struct team_state_gsc *gsc,
 				   void *priv)
@@ -2313,6 +2427,78 @@ static int lacp_state_fallback_get(struct teamd_context *ctx,
 	return 0;
 }
 
+struct lacp_state_fallback_info {
+	struct teamd_workq workq;
+	struct lacp *lacp;
+	bool fallback;
+};
+
+static int lacp_state_fallback_work(struct teamd_context *ctx,
+				    struct teamd_workq *workq)
+{
+	struct lacp_state_fallback_info *info;
+	struct lacp *lacp;
+	struct teamd_port *tdport;
+	int err = 0;
+
+	info = get_container(workq, struct lacp_state_fallback_info, workq);
+	lacp = info->lacp;
+	if (info->fallback == lacp->cfg.fallback)
+		goto out;
+
+	teamd_log_dbg(ctx, "fallback manually changed from %d to %d",
+		      lacp->cfg.fallback, info->fallback);
+	lacp->cfg.fallback = info->fallback;
+
+	teamd_for_each_tdport(tdport, lacp->ctx) {
+		struct lacp_port *lacp_port = lacp_port_get(lacp, tdport);
+		enum lacp_port_state state = lacp_port_get_state(lacp_port);
+
+		if (state != PORT_STATE_DEFAULTED &&
+		    state != PORT_STATE_FALLBACK)
+			continue;
+
+		if (lacp->cfg.fallback) {
+			if (state == PORT_STATE_DEFAULTED &&
+			    !lacp_port->fallback_timeout_expired) {
+				err = lacp_port_fallback_timeout_set(lacp_port);
+				if (err)
+					goto out;
+				teamd_loop_callback_enable(ctx,
+							   LACP_FALLBACK_TIMEOUT_CB_NAME,
+							   lacp_port);
+			}
+		} else {
+			lacp_port->fallback_timeout_expired = false;
+			teamd_loop_callback_disable(ctx,
+						    LACP_FALLBACK_TIMEOUT_CB_NAME,
+						    lacp_port);
+		}
+	}
+
+	err = lacp_ports_update_fallback_state(lacp);
+out:
+	free(info);
+	return err;
+}
+
+static int lacp_state_fallback_set(struct teamd_context *ctx,
+				   struct team_state_gsc *gsc,
+				   void *priv)
+{
+	struct lacp_state_fallback_info *info;
+	struct lacp *lacp = priv;
+
+	info = malloc(sizeof(*info));
+	if (!info)
+		return -ENOMEM;
+	teamd_workq_init_work(&info->workq, lacp_state_fallback_work);
+	info->lacp = lacp;
+	info->fallback = gsc->data.bool_val;
+	teamd_workq_schedule_work(ctx, &info->workq);
+	return 0;
+}
+
 static int lacp_state_fallback_timeout_get(struct teamd_context *ctx,
 					   struct team_state_gsc *gsc,
 					   void *priv)
@@ -2323,6 +2509,129 @@ static int lacp_state_fallback_timeout_get(struct teamd_context *ctx,
 	return 0;
 }
 
+struct lacp_state_fallback_timeout_info {
+	struct teamd_workq workq;
+	struct lacp *lacp;
+	uint16_t fallback_timeout;
+};
+
+static int lacp_state_fallback_timeout_work(struct teamd_context *ctx,
+					    struct teamd_workq *workq)
+{
+	struct lacp_state_fallback_timeout_info *info;
+	struct lacp *lacp;
+	struct teamd_port *tdport;
+	int err = 0;
+
+	info = get_container(workq, struct lacp_state_fallback_timeout_info,
+			     workq);
+	lacp = info->lacp;
+	if (info->fallback_timeout == lacp->cfg.fallback_timeout)
+		goto out;
+
+	teamd_log_dbg(ctx, "fallback_timeout manually changed from %u to %u",
+		      lacp->cfg.fallback_timeout, info->fallback_timeout);
+	lacp->cfg.fallback_timeout = info->fallback_timeout;
+
+	if (!lacp->cfg.fallback)
+		goto out;
+
+	teamd_for_each_tdport(tdport, lacp->ctx) {
+		struct lacp_port *lacp_port = lacp_port_get(lacp, tdport);
+
+		if (lacp_port_get_state(lacp_port) != PORT_STATE_DEFAULTED ||
+		    lacp_port->fallback_timeout_expired)
+			continue;
+
+		err = lacp_port_fallback_timeout_set(lacp_port);
+		if (err)
+			goto out;
+		teamd_loop_callback_enable(ctx, LACP_FALLBACK_TIMEOUT_CB_NAME,
+					   lacp_port);
+	}
+out:
+	free(info);
+	return err;
+}
+
+static int lacp_state_fallback_timeout_set(struct teamd_context *ctx,
+					   struct team_state_gsc *gsc,
+					   void *priv)
+{
+	struct lacp_state_fallback_timeout_info *info;
+	struct lacp *lacp = priv;
+
+	if (gsc->data.int_val < 1 || gsc->data.int_val > USHRT_MAX)
+		return -EINVAL;
+
+	info = malloc(sizeof(*info));
+	if (!info)
+		return -ENOMEM;
+	teamd_workq_init_work(&info->workq, lacp_state_fallback_timeout_work);
+	info->lacp = lacp;
+	info->fallback_timeout = gsc->data.int_val;
+	teamd_workq_schedule_work(ctx, &info->workq);
+	return 0;
+}
+
+static int lacp_state_min_ports_get(struct teamd_context *ctx,
+				    struct team_state_gsc *gsc,
+				    void *priv)
+{
+	struct lacp *lacp = priv;
+
+	gsc->data.int_val = lacp->cfg.min_ports;
+	return 0;
+}
+
+struct lacp_state_min_ports_info {
+	struct teamd_workq workq;
+	struct lacp *lacp;
+	int min_ports;
+};
+
+static int lacp_state_min_ports_work(struct teamd_context *ctx,
+				     struct teamd_workq *workq)
+{
+	struct lacp_state_min_ports_info *info;
+	struct lacp *lacp;
+	int err = 0;
+
+	info = get_container(workq, struct lacp_state_min_ports_info, workq);
+	lacp = info->lacp;
+	if (info->min_ports == lacp->cfg.min_ports)
+		goto out;
+
+	teamd_log_dbg(ctx, "min_ports manually changed from %d to %d",
+		      lacp->cfg.min_ports, info->min_ports);
+	lacp->cfg.min_ports = info->min_ports;
+	err = lacp_update_carrier(lacp);
+out:
+	free(info);
+	return err;
+}
+
+static int lacp_state_min_ports_set(struct teamd_context *ctx,
+				    struct team_state_gsc *gsc,
+				    void *priv)
+{
+	struct lacp_state_min_ports_info *info;
+	struct lacp *lacp = priv;
+
+	if (gsc->data.int_val < 1 ||
+	    gsc->data.int_val > LACP_CFG_DFLT_MIN_PORTS_MAX)
+		return -EINVAL;
+
+	info = malloc(sizeof(*info));
+	if (!info)
+		return -ENOMEM;
+	teamd_workq_init_work(&info->workq, lacp_state_min_ports_work);
+	info->lacp = lacp;
+	info->min_ports = gsc->data.int_val;
+	teamd_workq_schedule_work(ctx, &info->workq);
+	return 0;
+}
+
 static int lacp_state_select_policy_get(struct teamd_context *ctx,
 					struct team_state_gsc *gsc,
 					void *priv)
@@ -2498,6 +2807,7 @@ static const struct teamd_state_val lacp_state_vals[] = {
 		.subpath = "active",
 		.type = TEAMD_STATE_ITEM_TYPE_BOOL,
 		.getter = lacp_state_active_get,
+		.setter = lacp_state_active_set,
 	},
 	{
 		.subpath = "sys_prio",
@@ -2508,16 +2818,25 @@ static const struct teamd_state_val lacp_state_vals[] = {
 		.subpath = "fast_rate",
 		.type = TEAMD_STATE_ITEM_TYPE_BOOL,
 		.getter = lacp_state_fast_rate_get,
+		.setter = lacp_state_fast_rate_set,
 	},
 	{
 		.subpath = "fallback",
 		.type = TEAMD_STATE_ITEM_TYPE_BOOL,
 		.getter = lacp_state_fallback_get,
+		.setter = lacp_state_fallback_set,
 	},
 	{
 		.subpath = "fallback_timeout",
 		.type = TEAMD_STATE_ITEM_TYPE_INT,
 		.getter = lacp_state_fallback_timeout_get,
+		.setter = lacp_state_fallback_timeout_set,
+	},
+	{
+		.subpath = "min_ports",
+		.type = TEAMD_STATE_ITEM_TYPE_INT,
+		.getter = lacp_state_min_ports_get,
+		.setter = lacp_state_min_ports_set,
 	},
 	{
 		.subpath = "select_policy",
