+static int lacp_port_fallback_timeout_set(struct lacp_port *lacp_port)
+{
+	int err;
+	struct timespec ts;
+
+	ms_to_timespec(&ts, lacp_port->lacp->cfg.fallback_timeout * 1000);
+	err = teamd_loop_callback_timer_set(lacp_port->ctx,
+					    LACP_FALLBACK_TIMEOUT_CB_NAME,
+					    lacp_port, NULL, &ts);
+	if (err) {
+		teamd_log_err("Failed to set fallback timeout timer.");
+		return err;
+	}
+	return 0;
+}
 
