+static int lacp_callback_fallback_timeout(struct teamd_context *ctx, int events,
+					  void *priv)
+{
+	struct lacp_port *lacp_port = priv;
+
+	teamd_loop_callback_disable(ctx, LACP_FALLBACK_TIMEOUT_CB_NAME,
+				    lacp_port);
+
+	if (lacp_port_get_state(lacp_port) != PORT_STATE_DEFAULTED)
+		return 0;
+
+	teamd_log_info("%s: No LACPDU received within %u seconds, port is now "
+		       "fallback eligible.", lacp_port->tdport->ifname,
+		       lacp_port->lacp->cfg.fallback_timeout);
+	lacp_port->fallback_timeout_expired = true;
+
+	return lacp_port_agg_update(lacp_port);
+}
