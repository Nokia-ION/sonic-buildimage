From b4b8873f68d0b4e4ba59b3093a03aa3fc00b8daf Mon Sep 17 00:00:00 2001
From: varunama <varuna.m@nokia.com>
Date: Tue, 25 Aug 2026 18:31:23 +0530
Subject: [PATCH] Add configurable fallback timeout for LACP

The LACP fallback feature lets a port join the aggregator before any LACPDU
is received from the peer. Until now that happened as soon as the port
reached the defaulted state, which gives the peer no grace period to start
speaking LACP.

Add a "fallback_timeout" runner option (in seconds, default 90) so a port
only becomes fallback eligible after it has spent the whole timeout in the
defaulted state without hearing an LACPDU. Receiving an LACPDU (port goes
current) cancels the pending fallback. The configured value is exported
through the state interface as runner.fallback_timeout.

With multi-port fallback (PORT_STATE_FALLBACK), only one timeout-expired
defaulted member is elected. Disabling fallback at runtime demotes any
existing fallback member back to defaulted.
---
 teamd/teamd_runner_lacp.c | 130 ++++++++++++++++++++++++++++++++++----
 1 file changed, 117 insertions(+), 13 deletions(-)

diff --git a/teamd/teamd_runner_lacp.c b/teamd/teamd_runner_lacp.c
index 9dd91ba..93bb82d 100644
--- a/teamd/teamd_runner_lacp.c
+++ b/teamd/teamd_runner_lacp.c
@@ -202,6 +202,8 @@ struct lacp {
 #define		LACP_CFG_DFLT_FAST_RATE false
 		bool fallback;
 #define		LACP_CFG_DFLT_FALLBACK false
+		uint16_t fallback_timeout;
+#define		LACP_CFG_DFLT_FALLBACK_TIMEOUT 90
 		int min_ports;
 #define		LACP_CFG_DFLT_MIN_PORTS 1
 #define		LACP_CFG_DFLT_MIN_PORTS_MAX 1024
@@ -246,6 +248,7 @@ struct lacp_port {
 	struct lacpdu_info __partner_last; /* last state before update */
 	int partner_retry_count;
 	bool periodic_on;
+	bool fallback_timeout_expired;
 	struct lacp_port *agg_lead; /* leading port of aggregator.
 				     * NULL in case this port is not selected */
 	enum lacp_port_state state;
@@ -557,6 +560,18 @@ static int lacp_load_config(struct teamd_context *ctx, struct lacp *lacp)
 		lacp->cfg.fallback = LACP_CFG_DFLT_FALLBACK;
 	teamd_log_dbg(ctx, "Using fallback \"%d\".", lacp->cfg.fallback);
 
+	err = teamd_config_int_get(ctx, &tmp, "$.runner.fallback_timeout");
+	if (err) {
+		lacp->cfg.fallback_timeout = LACP_CFG_DFLT_FALLBACK_TIMEOUT;
+	} else if (tmp < 1 || tmp > USHRT_MAX) {
+		teamd_log_err("\"fallback_timeout\" value is out of its limits.");
+		return -EINVAL;
+	} else {
+		lacp->cfg.fallback_timeout = tmp;
+	}
+	teamd_log_dbg(ctx, "Using fallback_timeout \"%d\".",
+		      lacp->cfg.fallback_timeout);
+
 	err = teamd_config_int_get(ctx, &tmp, "$.runner.min_ports");
 	if (err) {
 		lacp->cfg.min_ports = LACP_CFG_DFLT_MIN_PORTS;
@@ -1179,6 +1194,23 @@ static int slow_addr_del(struct lacp_port *lacp_port)
 #define LACP_PERIODIC_CB_NAME "lacp_periodic"
 #define LACP_TIMEOUT_CB_NAME "lacp_timeout"
 #define LACP_RETRY_COUNT_TIMEOUT_CB_NAME "lacp_retry_count_timeout"
+#define LACP_FALLBACK_TIMEOUT_CB_NAME "lacp_fallback_timeout"
+
+static int lacp_port_fallback_timeout_set(struct lacp_port *lacp_port)
+{
+	int err;
+	struct timespec ts;
+
+	ms_to_timespec(&ts, lacp_port->lacp->cfg.fallback_timeout * 1000);
+	err = teamd_loop_callback_timer_set(lacp_port->ctx,
+					    LACP_FALLBACK_TIMEOUT_CB_NAME,
+					    lacp_port, NULL, &ts);
+	if (err) {
+		teamd_log_err("Failed to set fallback timeout timer.");
+		return err;
+	}
+	return 0;
+}
 
 static int lacp_port_timeout_set(struct lacp_port *lacp_port, bool fast_forced)
 {
@@ -1360,17 +1392,12 @@ static int lacp_ports_update_fallback_state(struct lacp *lacp)
 	struct lacp_port *current_fallback = NULL;
 	struct lacp_port *new_fallback = NULL;
 	struct teamd_port *tdport;
-	bool do_fallback = true;
-
-	/* If fallback is disabled, no need to do anything. */
-	if (!lacp->cfg.fallback) {
-		return 0;
-	}
+	bool do_fallback = lacp->cfg.fallback;
 
 	/* Check all ports.
 	 * If any port is receiving LACPDUs, we disable fallback altogether.
-	 * Otherwise, the non-disabled port with the highest priority is moved
-	 * to fallback mode. */
+	 * Otherwise, one non-disabled port that has waited out fallback_timeout
+	 * is moved to fallback mode. */
 	teamd_for_each_tdport(tdport, lacp->ctx) {
 		struct lacp_port *lacp_port = lacp_port_get(lacp, tdport);
 
@@ -1388,8 +1415,13 @@ static int lacp_ports_update_fallback_state(struct lacp *lacp)
 			current_fallback = lacp_port;
 		}
 
-		/* Port is either defaulted or already fallback, so it's a candidate for new fallback port.
-		 * If there is already a viable candidate, check which one has higher priority. */
+		/* Only the already-elected fallback port, or a defaulted port
+		 * that has waited the whole fallback_timeout, may be selected. */
+		if (lacp_port->state != PORT_STATE_FALLBACK &&
+		    !(lacp_port->state == PORT_STATE_DEFAULTED &&
+		      lacp_port->fallback_timeout_expired))
+			continue;
+
 		if (lacp_port_better_for_fallback(lacp_port, new_fallback)) {
 			new_fallback = lacp_port;
 		}
@@ -1438,6 +1470,11 @@ static int lacp_port_set_state(struct lacp_port *lacp_port,
 
 	switch(new_state) {
 	case PORT_STATE_CURRENT:
+		/* The peer is talking to us again, cancel any pending fallback. */
+		lacp_port->fallback_timeout_expired = false;
+		teamd_loop_callback_disable(lacp_port->ctx,
+					    LACP_FALLBACK_TIMEOUT_CB_NAME,
+					    lacp_port);
 		break;
 	case PORT_STATE_EXPIRED:
 		teamd_loop_callback_enable(lacp_port->ctx,
@@ -1461,6 +1498,23 @@ static int lacp_port_set_state(struct lacp_port *lacp_port,
 					   LACP_TIMEOUT_CB_NAME, lacp_port);
 		break;
 	case PORT_STATE_DEFAULTED:
+		teamd_loop_callback_disable(lacp_port->ctx,
+					    LACP_TIMEOUT_CB_NAME, lacp_port);
+		memset(&lacp_port->partner, 0, sizeof(lacp_port->partner));
+		lacp_port->partner.state |= INFO_STATE_LACP_TIMEOUT;
+		err = lacp_port_partner_update(lacp_port);
+		if (err)
+			return err;
+		if (lacp_port->lacp->cfg.fallback &&
+		    !lacp_port->fallback_timeout_expired) {
+			err = lacp_port_fallback_timeout_set(lacp_port);
+			if (err)
+				return err;
+			teamd_loop_callback_enable(lacp_port->ctx,
+						   LACP_FALLBACK_TIMEOUT_CB_NAME,
+						   lacp_port);
+		}
+		break;
 	case PORT_STATE_FALLBACK:
 		teamd_loop_callback_disable(lacp_port->ctx,
 					    LACP_TIMEOUT_CB_NAME, lacp_port);
@@ -1471,6 +1525,10 @@ static int lacp_port_set_state(struct lacp_port *lacp_port,
 			return err;
 		break;
 	case PORT_STATE_DISABLED:
+		lacp_port->fallback_timeout_expired = false;
+		teamd_loop_callback_disable(lacp_port->ctx,
+					    LACP_FALLBACK_TIMEOUT_CB_NAME,
+					    lacp_port);
 		memset(&lacp_port->partner, 0, sizeof(lacp_port->partner));
 		err = lacp_port_partner_update(lacp_port);
 		if (err)
@@ -1767,6 +1825,25 @@ static int lacp_callback_timeout(struct teamd_context *ctx, int events,
 	return err;
 }
 
+static int lacp_callback_fallback_timeout(struct teamd_context *ctx, int events,
+					  void *priv)
+{
+	struct lacp_port *lacp_port = priv;
+
+	teamd_loop_callback_disable(ctx, LACP_FALLBACK_TIMEOUT_CB_NAME,
+				    lacp_port);
+
+	if (lacp_port_get_state(lacp_port) != PORT_STATE_DEFAULTED)
+		return 0;
+
+	teamd_log_info("%s: No LACPDU received within %u seconds, port is now "
+		       "fallback eligible.", lacp_port->tdport->ifname,
+		       lacp_port->lacp->cfg.fallback_timeout);
+	lacp_port->fallback_timeout_expired = true;
+
+	return lacp_ports_update_fallback_state(lacp_port->lacp);
+}
+
 static int lacp_callback_retry_count_timeout(struct teamd_context *ctx, int events,
 				 void *priv)
 {
@@ -1870,6 +1947,7 @@ static int lacp_port_added(struct teamd_context *ctx,
 	lacp_port->tdport = tdport;
 	lacp_port->lacp = lacp;
 	lacp_port->partner_retry_count = LACP_CFG_DFLT_RETRY_COUNT;
+	lacp_port->fallback_timeout_expired = false;
 
 	err = lacp_port_load_config(ctx, lacp_port);
 	if (err) {
@@ -1913,11 +1991,19 @@ static int lacp_port_added(struct teamd_context *ctx,
 		goto periodic_callback_del;
 	}
 
+	err = teamd_loop_callback_timer_add(ctx, LACP_FALLBACK_TIMEOUT_CB_NAME,
+					    lacp_port,
+					    lacp_callback_fallback_timeout);
+	if (err) {
+		teamd_log_err("Failed add fallback timeout callback timer");
+		goto timeout_callback_del;
+	}
+
 	/* refresh ports from the kernel */
 	err = team_refresh(ctx->th);
 	if (err) {
 		teamd_log_err("%s: Team refresh failed.", tdport->ifname);
-		goto timeout_callback_del;
+		goto fallback_timeout_callback_del;
 	}
 
 	/* Newly added ports are disabled */
@@ -1925,12 +2011,12 @@ static int lacp_port_added(struct teamd_context *ctx,
 	if (err) {
 		teamd_log_err("%s: Failed to disable port.", tdport->ifname);
 		if (!TEAMD_ENOENT(err))
-			goto timeout_callback_del;
+			goto fallback_timeout_callback_del;
 	}
 
 	err = lacp_port_set_mac(ctx, tdport);
 	if (err)
-		goto timeout_callback_del;
+		goto fallback_timeout_callback_del;
 
 	lacp_port_actor_init(lacp_port);
 	lacp_port_link_update(lacp_port);
@@ -1938,6 +2024,8 @@ static int lacp_port_added(struct teamd_context *ctx,
 	teamd_loop_callback_enable(ctx, LACP_SOCKET_CB_NAME, lacp_port);
 	return 0;
 
+fallback_timeout_callback_del:
+	teamd_loop_callback_del(ctx, LACP_FALLBACK_TIMEOUT_CB_NAME, lacp_port);
 timeout_callback_del:
 	teamd_loop_callback_del(ctx, LACP_TIMEOUT_CB_NAME, lacp_port);
 periodic_callback_del:
@@ -1964,6 +2052,7 @@ static void lacp_port_removed(struct teamd_context *ctx,
 		   which sends EXPIRED LACP PDU update */
 		lacp_port_set_state(lacp_port, PORT_STATE_DISABLED);
 	}
+	teamd_loop_callback_del(ctx, LACP_FALLBACK_TIMEOUT_CB_NAME, lacp_port);
 	teamd_loop_callback_del(ctx, LACP_TIMEOUT_CB_NAME, lacp_port);
 	teamd_loop_callback_del(ctx, LACP_PERIODIC_CB_NAME, lacp_port);
 	teamd_loop_callback_del(ctx, LACP_SOCKET_CB_NAME, lacp_port);
@@ -2224,6 +2313,16 @@ static int lacp_state_fallback_get(struct teamd_context *ctx,
 	return 0;
 }
 
+static int lacp_state_fallback_timeout_get(struct teamd_context *ctx,
+					   struct team_state_gsc *gsc,
+					   void *priv)
+{
+	struct lacp *lacp = priv;
+
+	gsc->data.int_val = lacp->cfg.fallback_timeout;
+	return 0;
+}
+
 static int lacp_state_select_policy_get(struct teamd_context *ctx,
 					struct team_state_gsc *gsc,
 					void *priv)
@@ -2415,6 +2514,11 @@ static const struct teamd_state_val lacp_state_vals[] = {
 		.type = TEAMD_STATE_ITEM_TYPE_BOOL,
 		.getter = lacp_state_fallback_get,
 	},
+	{
+		.subpath = "fallback_timeout",
+		.type = TEAMD_STATE_ITEM_TYPE_INT,
+		.getter = lacp_state_fallback_timeout_get,
+	},
 	{
 		.subpath = "select_policy",
 		.type = TEAMD_STATE_ITEM_TYPE_STRING,
-- 
2.43.0

