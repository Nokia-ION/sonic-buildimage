From: srinj <sriniketh.j@nokia.com>
Date: Wed, 2 Sep 2026 12:40:11 +0530
Subject: [PATCH] show primary ip in backup state

---
 vrrpd/vrrp.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/vrrpd/vrrp.c b/vrrpd/vrrp.c
index 3554671580..0c10e465d6 100644
--- a/vrrpd/vrrp.c
+++ b/vrrpd/vrrp.c
@@ -1649,7 +1649,6 @@ static void vrrp_change_state_backup(struct vrrp_router *r)
 	r->advert_pending = false;
 	r->garp_pending = false;
 	r->ndisc_pending = false;
-	memset(&r->src, 0x00, sizeof(r->src));
 
 	vrrp_zclient_send_interface_protodown(r->mvl_ifp, true);
 }
