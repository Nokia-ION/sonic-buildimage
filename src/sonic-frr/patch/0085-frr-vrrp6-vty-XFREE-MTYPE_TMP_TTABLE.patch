From 32d9d03b095da347f91f34f8f9d419c695e44c8e Mon Sep 17 00:00:00 2001
From: brajarat <balachandar.rajarathinam@nokia.com>
Date: Tue, 25 Aug 2026 10:50:00 +0530
Subject: [PATCH] vrrpd: free ttable_dump buffer with correct memtype

---
 vrrpd/vrrp6_vty.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/vrrpd/vrrp6_vty.c b/vrrpd/vrrp6_vty.c
index 2511876c22..63a354cdb3 100644
--- a/vrrpd/vrrp6_vty.c
+++ b/vrrpd/vrrp6_vty.c
@@ -515,7 +515,7 @@ static void vrrp6_show(struct vty *vty, struct vrrp_vrouter *vr)
 	char *table = ttable_dump(tt, "\n");
 
 	vty_out(vty, "\n%s\n", table);
-	XFREE(MTYPE_TMP, table);
+	XFREE(MTYPE_TMP_TTABLE, table);
 	ttable_del(tt);
 }
 
@@ -621,7 +621,7 @@ DEFPY_YANG(vrrp6_vrid_show_summary,
 	char *table = ttable_dump(tt, "\n");
 
 	vty_out(vty, "\n%s\n", table);
-	XFREE(MTYPE_TMP, table);
+	XFREE(MTYPE_TMP_TTABLE, table);
 	ttable_del(tt);
 
 	list_delete(&ll);
-- 
2.34.1

